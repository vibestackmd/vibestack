# Ubuntu + real Claude CLI — for end-to-end plugin install tests against a
# locally-built marketplace. Validates the about-to-ship plugin (not the
# previously-published version) by pointing claude at dist/test-marketplace/.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV NONINTERACTIVE=1
ENV HOME=/root
ENV USER=root
ENV SHELL=/bin/bash

# Base tools + Node (Claude CLI runtime). We install Node here rather than
# letting the Claude installer fetch it, so the image build is deterministic.
RUN apt-get update && apt-get install -y \
      curl ca-certificates sudo python3 git \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Claude CLI via the official installer. The installer drops the
# binary into ~/.local/bin (or ~/.claude/local/bin); add both to PATH so
# subsequent layers and the test script can find it.
RUN curl -fsSL https://claude.ai/install.sh | bash || true
ENV PATH="/root/.local/bin:/root/.claude/local/bin:${PATH}"

# Sanity: fail the build if claude isn't on PATH — the whole point of this
# image is to run real plugin install commands.
RUN claude --version

WORKDIR /workspace
