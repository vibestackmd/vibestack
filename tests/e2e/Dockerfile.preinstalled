# Ubuntu with a pre-populated ~/.claude/ — tests the settings.json merge preserves user values
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV NONINTERACTIVE=1
ENV HOME=/root
ENV USER=root
ENV SHELL=/bin/bash

RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    sudo \
    python3 \
    git \
    zsh \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Pre-create a user-level settings.json with a custom value the merge must preserve,
# plus voiceEnabled=false to verify VibeStack doesn't overwrite an explicitly-set user value.
RUN mkdir -p /root/.claude && \
    printf '%s\n' \
      '{' \
      '  "user-custom-key": "should-survive-merge",' \
      '  "voiceEnabled": false,' \
      '  "permissions": {' \
      '    "allow": ["WebFetch(domain:example.com)"]' \
      '  }' \
      '}' > /root/.claude/settings.json

WORKDIR /workspace
